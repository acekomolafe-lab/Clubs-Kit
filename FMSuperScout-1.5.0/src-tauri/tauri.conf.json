{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "FMSuperScout",
  "version": "0.1.0",
  "identifier": "com.fmsuperscout.app",
  "build": {
    "frontendDist": "../app"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "FMSuperScout",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --js-flags=--max-old-space-size=4096"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**",
          "$LOCALDATA/**",
          "$APPDATA/**",
          "$APPLOCALDATA/**",
          "$HOME/**",
          "$DATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  }
}

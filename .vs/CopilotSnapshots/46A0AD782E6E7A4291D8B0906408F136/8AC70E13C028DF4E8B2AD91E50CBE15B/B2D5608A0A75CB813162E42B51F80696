async function tauriInvoke(cmd, args) {
  if (typeof window !== 'undefined' && window.__TAURI__ && window.__TAURI__.core && typeof window.__TAURI__.core.invoke === 'function') {
    return window.__TAURI__.core.invoke(cmd, args);
  }
  if (cmd === 'get_sponsor_groupings') {
    const configPath = args?.configPath || DEFAULT_SPONSOR_CONFIG_PATH;
    const res = await fetch('/api/sponsor-groupings?path=' + encodeURIComponent(configPath));
    const body = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(body.error || `Sponsor config request failed (${res.status})`);
    return body;
  }
  if (cmd === 'get_clubs') {
    try {
      const res = await fetch('/api/clubs');
      if (res.ok) return await res.json();
    } catch(e) {}
    // Fallback if fetch fails:
    return { clubs: [] };
  }
  throw new Error('Unknown command: ' + cmd);
}


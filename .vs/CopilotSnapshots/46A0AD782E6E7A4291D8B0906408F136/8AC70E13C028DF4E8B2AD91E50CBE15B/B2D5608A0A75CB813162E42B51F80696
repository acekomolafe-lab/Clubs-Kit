function mapFmStyleId(styleId, clubName = '') {
  const sid = Number(styleId);
  const name = String(clubName || '').toLowerCase();
  if (sid === 4 || [13, 14, 15, 16, 19].includes(sid)) return 'Hooped';
  if ([5, 23].includes(sid)) return 'Bicolour';
  if ([6, 7, 8, 9].includes(sid)) return 'Sleeved';
  if ([3, 10, 11, 12, 17, 18, 20, 21, 22, 24, 25, 26, 27, 28, 29, 30, 31, 37, 44, 48, 49, 50, 51, 56].includes(sid)) {
    if (name.includes('celtic') || name.includes('hoop') || name.includes('sporting')) return 'Hooped';
    return 'Striped';
  }
  if ([0, 1, 2, 34, 35, 36].includes(sid)) return 'Plain';
  return 'Plain';
}

function resolveClubKitStyle(c, idKey, nameKey, kitIndex = 1) {
  const idStr = String(idKey || (c ? (c.clubId || c.id || '') : ''));
  const name = String(nameKey || (c ? (c.club || c.name || '') : '')).toLowerCase();

  // If in-game style is present and > 0, map it from memory
  if (c) {
    let rawStyle = null;
    if (kitIndex === 1) rawStyle = c.k1Style != null ? c.k1Style : (c.style != null ? c.style : null);
    else if (kitIndex === 2) rawStyle = c.k2Style;
    else if (kitIndex === 3) rawStyle = c.k3Style;

    if (rawStyle != null && Number(rawStyle) > 0) {
      return mapFmStyleId(rawStyle, name);
    }
  }

  // Fallbacks only apply to Home kit by default
  if (kitIndex === 1) {
    if (idStr && FAMOUS_CLUB_STYLES[idStr]) {
      return FAMOUS_CLUB_STYLES[idStr];
    }
    // Name keywords for known traditions
    if (name.includes('celtic') || name.includes('hoop')) return 'Hooped';
    if (name.includes('feyenoord') || name.includes('blackburn')) return 'Bicolour';
    if (name.includes('arsenal') || name.includes('aston villa') || name.includes('west ham')) return 'Sleeved';
    if (name.includes('athletic') || name.includes('atletico') || name.includes('striped') || name.includes('newcastle')) return 'Striped';
    return 'Plain';
  }

  return '0'; // Kitbasher expects '0' for Don't Care on Away/Third
}


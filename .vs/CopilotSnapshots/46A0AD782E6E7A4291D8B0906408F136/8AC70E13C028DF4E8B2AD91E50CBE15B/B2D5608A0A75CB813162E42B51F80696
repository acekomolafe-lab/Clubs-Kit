  'Albanian': 'Albania', 'Macedonian': 'North Macedonia', 'Montenegrin': 'Montenegro', 'Luxembourger': 'Luxembourg',
  'Malian': 'Mali', 'Ivorian': 'Ivory Coast', 'Cape Verdean': 'Cape Verde', 'Zambian': 'Zambia',
  'Zimbabwean': 'Zimbabwe', 'Ugandan': 'Uganda', 'Kenyan': 'Kenya', 'Togolese': 'Togo', 'Beninese': 'Benin'
};

function displayCountry(raw) {
  if (!raw) return '';
  return COUNTRY_MAP[raw] || raw;
}

function clubIdOf(name) {
  let h = 0x811c9dc5;
  const s = String(name || '');
  for (let i = 0; i < s.length; i++) {
    h ^= s.charCodeAt(i);
    h = Math.imul(h, 0x01000193);
  }
  return (h >>> 0).toString();
}

const PAGE_SIZE = 200;

let clubs = [];
let kitColors = {};
let selectedClubs = new Set();
let activeClubId = '';
let sortKey = 'club', sortDir = 1, page = 0;
let groupBy = 'none';
let collapsedGroups = new Set();
let showAllClubs = false;
let filterCountry = '';
let filterDivision = '';

// Editing state for color picker
let currentEditingClubId = null;
let currentEditingSlot = null;
let userCustomized = {};

function loadUserCustomized() {
  try { userCustomized = JSON.parse(localStorage.getItem(CUSTOM_KEY) || '{}'); }
  catch { userCustomized = {}; }
}

function saveUserCustomized() {
  try { localStorage.setItem(CUSTOM_KEY, JSON.stringify(userCustomized)); } catch { }
}

function loadKitColors() {
  loadKitStyles();
  try { kitColors = JSON.parse(localStorage.getItem(KIT_KEY) || '{}'); }
  catch { kitColors = {}; }
}

function saveKitColors() {
  try { localStorage.setItem(KIT_KEY, JSON.stringify(kitColors)); } catch { }
}

function kitColorOf(clubOrId, slot) {
  const k = String(clubOrId || '');
  const rec = kitColors[k];
  if (rec && rec[slot]) return rec[slot];
  const c = clubs.find(x => String(x.clubId) === k || x.club === k);
  if (c) {
    const altRec = kitColors[String(c.clubId)] || kitColors[c.club];
    if (altRec && altRec[slot]) return altRec[slot];
    if (slot === 'home1') return c.k1BgColor || c.bgColor || '';
    if (slot === 'home2') return c.k1FgColor || c.fgColor || '';
    if (slot === 'home3') return c.k1OutColor || c.outlineColor || c.k1FgColor || c.fgColor || '';
    if (slot === 'away1') return c.k2BgColor || '';
    if (slot === 'away2') return c.k2FgColor || '';
    if (slot === 'away3') return c.k2OutColor || c.k2FgColor || '';
    if (slot === 'third1') return c.k3BgColor || '';
    if (slot === 'third2') return c.k3FgColor || '';
    if (slot === 'third3') return c.k3OutColor || c.k3FgColor || '';
  }
  return '';
}

function escCsv(v) {
  const s = String(v == null ? '' : v);
  return /[",\n]/.test(s) ? '"' + s.replace(/"/g, '""') + '"' : s;
}

function escHtml(s) {
  return String(s || '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
}

async function loadClubs() {
  $('status').textContent = 'Loading…';
  let data;
  try {
    data = await tauriInvoke('get_clubs');
  } catch(e) {
    console.error("invoke failed:", e);
    $('empty').classList.remove('hidden');
    $('tbl').classList.add('hidden');
    $('tbl').style.display = 'none';
    $('status').textContent = 'Error: ' + String(e);
    return;
  }

  const rawClubs = data.clubs || [];
  clubs = rawClubs.map(c => {
    const clubName = c.club || c.name || '';
    const clubId = c.clubId || c.id || c.uniqueId || clubIdOf(clubName);
    const division = c.division || '';
    const country = c.country || c.nation || '';
    const isWomen = isWomenClub({ club: clubName, division, ...c });
    const idKey = String(clubId);

    if (!kitColors[idKey]) {
      kitColors[idKey] = kitColors[clubName] ? { ...kitColors[clubName] } : {};
    }

    // Seed purely from authentic in-game memory
    const h1 = c.k1BgColor || c.bgColor || '';
    const h2 = c.k1FgColor || c.fgColor || '';
    const h3 = c.k1OutColor || c.outlineColor || h2 || h1 || '';
    const a1 = c.k2BgColor || '';
    const a2 = c.k2FgColor || '';
    const a3 = c.k2OutColor || a2 || a1 || '';
    const t1 = c.k3BgColor || '';
    const t2 = c.k3FgColor || '';
    const t3 = c.k3OutColor || t2 || t1 || '';

    if (h1 && !userCustomized[idKey + ':home1']) kitColors[idKey].home1 = h1;
    if (h2 && !userCustomized[idKey + ':home2']) kitColors[idKey].home2 = h2;
    if (h3 && !userCustomized[idKey + ':home3']) kitColors[idKey].home3 = h3;

    if (a1 && !userCustomized[idKey + ':away1']) kitColors[idKey].away1 = a1;
    if (a2 && !userCustomized[idKey + ':away2']) kitColors[idKey].away2 = a2;
    if (a3 && !userCustomized[idKey + ':away3']) kitColors[idKey].away3 = a3;

    if (t1 && !userCustomized[idKey + ':third1']) kitColors[idKey].third1 = t1;
    if (t2 && !userCustomized[idKey + ':third2']) kitColors[idKey].third2 = t2;
    if (t3 && !userCustomized[idKey + ':third3']) kitColors[idKey].third3 = t3;

    return {
      ...c,
      club: clubName,
      clubId,
      division,
      country,
      isWomen,
      shortName: c.shortName || '',
      initials: c.initials || '',
      badgePath: c.badgePath || '',
    };
  });

  saveKitColors();

  if (!clubs.length) {
    $('empty').classList.remove('hidden');
    $('tbl').classList.add('hidden');
    $('tbl').style.display = 'none';
    const prompt = $('search-prompt');
    if (prompt) prompt.classList.add('hidden');
    $('status').textContent = '';
    return;
  }

  selectedClubs = new Set();

  if (!clubs.some(c => String(c.clubId) === String(activeClubId))) {
    activeClubId = clubs[0]?.clubId ? String(clubs[0].clubId) : '';
  }

  $('empty').classList.add('hidden');
  populateCountryDropdown();
  populateDivisionDropdown();
  updateStatus();
  render();
}

function populateCountryDropdown() {
  const sel = $('sel-country');
  if (!sel) return;

  let relevantClubs = clubs;
  if (filterGender === 'men') {
    relevantClubs = relevantClubs.filter(c => !isWomenClub(c));
  } else if (filterGender === 'women') {
    relevantClubs = relevantClubs.filter(c => isWomenClub(c));
  }

  const countMap = new Map();
  for (const c of relevantClubs) {
    const name = displayCountry(c.country);
    if (name) {
      countMap.set(name, (countMap.get(name) || 0) + 1);
    }
  }

  const sortedCountries = Array.from(countMap.keys()).sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));

  if (filterCountry && !countMap.has(filterCountry)) {
    filterCountry = '';
  }

  const genderSuffix = filterGender === 'women' ? " (Women's Clubs)" : (filterGender === 'men' ? " (Men's Clubs)" : "");
  let html = `<option value="">All Countries${genderSuffix}</option>`;
  for (const name of sortedCountries) {
    const cnt = countMap.get(name);
    const isSelected = (name === filterCountry);
    html += `<option value="${escHtml(name)}"${isSelected ? ' selected' : ''}>${escHtml(name)} (${cnt.toLocaleString()})</option>`;
  }
  sel.innerHTML = html;
}

function populateDivisionDropdown() {
  const sel = $('sel-division');
  if (!sel) return;

  let relevantClubs = clubs;
  if (filterGender === 'men') {
    relevantClubs = relevantClubs.filter(c => !isWomenClub(c));
  } else if (filterGender === 'women') {
    relevantClubs = relevantClubs.filter(c => isWomenClub(c));
  }
  if (filterCountry) {
    relevantClubs = relevantClubs.filter(c => c.country === filterCountry || displayCountry(c.country) === filterCountry);
  }

  const countMap = new Map();
  for (const c of relevantClubs) {
    const div = c.division && c.division.trim();
    if (div) {
      countMap.set(div, (countMap.get(div) || 0) + 1);
    }
  }

  const sortedDivs = Array.from(countMap.keys()).sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));

  // If current filterDivision is no longer in this division list, reset it
  if (filterDivision && !countMap.has(filterDivision)) {
    filterDivision = '';
  }

  const genderSuffix = filterGender === 'women' ? " (Women)" : (filterGender === 'men' ? " (Men)" : "");
  const defaultLabel = filterCountry ? `All Divisions in ${filterCountry}${genderSuffix}` : `All Divisions${genderSuffix}`;
  let html = `<option value="">${escHtml(defaultLabel)}</option>`;
  for (const div of sortedDivs) {
    const cnt = countMap.get(div);
    const isSelected = (div === filterDivision);
    html += `<option value="${escHtml(div)}"${isSelected ? ' selected' : ''}>${escHtml(div)} (${cnt.toLocaleString()})</option>`;
  }
  sel.innerHTML = html;
}

function updateStatus() {
  const q = ($('search').value || '').toLowerCase().trim();
  const isGenderActive = Boolean(filterGender && filterGender !== 'all');
  const hasActiveFilter = Boolean(q || filterCountry || filterDivision || isGenderActive || showAllClubs);
  const total = clubs.length;
  const sel = selectedClubs.size;

  if (!hasActiveFilter) {
    $('status').textContent = `${total.toLocaleString()} clubs in database`;
  } else if (q || filterCountry || filterDivision || isGenderActive) {
    const list = applyFilter(clubs);
    const genderTag = filterGender === 'women' ? " women's" : (filterGender === 'men' ? " men's" : "");
    $('status').textContent = `${list.length.toLocaleString()}${genderTag} clubs found · ${sel} selected`;
  } else {
    $('status').textContent = `${sel} / ${total.toLocaleString()} selected`;
  }
  updateMasterCheck();
}

function updateMasterCheck() {
  const master = $('master-check');
  if (!master) return;
  const q = ($('search').value || '').toLowerCase().trim();
  const isGenderActive = Boolean(filterGender && filterGender !== 'all');
  const hasActiveFilter = Boolean(q || filterCountry || filterDivision || isGenderActive || showAllClubs);
  const list = !hasActiveFilter ? [] : applyFilter(clubs);
  if (!list.length) {
    master.classList.remove('checked', 'indeterminate');
    return;
  }
  const selCount = list.filter(c => selectedClubs.has(String(c.clubId))).length;
  if (selCount === list.length && list.length > 0) {
    master.classList.remove('indeterminate');
    master.classList.add('checked');
  } else if (selCount > 0) {
    master.classList.remove('checked');
    master.classList.add('indeterminate');
  } else {
    master.classList.remove('checked', 'indeterminate');
  }
}

function applyFilter(list) {
  let res = list;
  if (filterGender === 'men') {
    res = res.filter(c => !isWomenClub(c));
  } else if (filterGender === 'women') {
    res = res.filter(c => isWomenClub(c));
  }
  if (filterCountry) {
    res = res.filter(c => c.country === filterCountry || displayCountry(c.country) === filterCountry);
  }
  if (filterDivision) {
    res = res.filter(c => c.division === filterDivision);
  }
  const q = ($('search').value || '').toLowerCase().trim();
  if (q) {
    const rawTokens = q.split(/\s+/).filter(Boolean);
    res = res.filter(c => {
      const isW = isWomenClub(c);
      const hay = [
        c.club || '',
        String(c.clubId || ''),
        c.division || '',
        c.country || '',
        displayCountry(c.country)
      ].join(' ').toLowerCase();

      return rawTokens.every(tok => {
        if (tok === 'women' || tok === 'female' || tok === 'ladies') return isW;
        if (tok === 'men' || tok === 'male') return !isW;
        return hay.includes(tok);
      });
    });
  }
  return res;
}

function sortClubs(list) {
  const dir = sortDir;
  return [...list].sort((a, b) => {
    if (sortKey === 'clubId') {
      const an = Number(a.clubId), bn = Number(b.clubId);
      if (!isNaN(an) && !isNaN(bn)) return (an - bn) * dir;
      return String(a.clubId || '').localeCompare(String(b.clubId || ''), undefined, { numeric: true }) * dir;
    }
    if (sortKey === 'sponsor') {
      const av = getClubSponsor(a), bv = getClubSponsor(b);
      return av.localeCompare(bv) * dir;
    }
    if (sortKey === 'template') {
      const av = getClubTemplate(a), bv = getClubTemplate(b);
      return av.localeCompare(bv) * dir;
    }
    if (sortKey === 'shortName') {
      const av = getClubShortName(a), bv = getClubShortName(b);
      return av.localeCompare(bv) * dir;
    }
    if (sortKey === 'badge') {
      const av = resolveBadgePath(a.club, a.clubId, a.badgePath);
      const bv = resolveBadgePath(b.club, b.clubId, b.badgePath);
      return av.localeCompare(bv) * dir;
    }
    if (sortKey === 'home' || sortKey === 'away' || sortKey === 'third') {
      const slot = `${sortKey}1`;
      const av = kitColorOf(a.clubId, slot) || '';
      const bv = kitColorOf(b.clubId, slot) || '';
      if (!av && bv) return 1 * dir;
      if (av && !bv) return -1 * dir;
      return av.localeCompare(bv) * dir;
    }
    if (sortKey === 'style') {
      const av = kitStyleOf(a);
      const bv = kitStyleOf(b);
      return av.localeCompare(bv) * dir;
    }
    const av = a[sortKey], bv = b[sortKey];
    return String(av || '').localeCompare(String(bv || ''), undefined, { numeric: true }) * dir;
  });
}

function updateSortIndicators() {
  const headers = [
    { el: $('th-team-name'), key: 'club' },
    { el: $('th-unique-id'), key: 'clubId' },
    { el: $('th-sponsor'), key: 'sponsor' },
    { el: $('th-template'), key: 'template' },
    { el: $('th-shortname'), key: 'shortName' },
    { el: $('th-badge'), key: 'badge' },
    { el: $('th-home-colours'), key: 'home' },
    { el: $('th-away-colours'), key: 'away' },
    { el: $('th-third-colours'), key: 'third' },
    { el: $('th-home-style'), key: 'style' },
    { el: $('th-away-style'), key: 'style-away' },
    { el: $('th-third-style'), key: 'style-third' },
  ];
  for (const h of headers) {
    if (!h.el) continue;
    h.el.classList.remove('sort-active', 'sort-asc', 'sort-desc');
    if (h.key === sortKey) {
      h.el.classList.add('sort-active', sortDir === 1 ? 'sort-asc' : 'sort-desc');
    }
  }
}

function swatchesHtml(c, group) {
  const idStr = String(c.clubId || c.club || '');
  const s1 = kitColorOf(idStr, `${group}1`);
  const s2 = kitColorOf(idStr, `${group}2`) || s1;
  const s3 = kitColorOf(idStr, `${group}3`) || s2 || s1;

  function swatchTag(slot, color) {
    const slotType = slot.endsWith('1') ? 'Background' : (slot.endsWith('2') ? 'Foreground' : 'Outline');
    const groupUpper = group.charAt(0).toUpperCase() + group.slice(1);
    const isFilled = Boolean(color);
    const bgStyle = isFilled ? `style="background:${color};"` : '';
    const title = isFilled 
      ? `${groupUpper} ${slotType}: ${color} (click to change, right-click to clear)` 
      : `${groupUpper} ${slotType}: Empty (click to set)`;
    return `<div class="swatch ${isFilled ? 'filled' : 'empty'}" data-club-id="${escHtml(idStr)}" data-slot="${slot}" ${bgStyle} title="${title}"></div>`;
  }

  return `<div class="swatches-container swatch-group">
    ${swatchTag(`${group}1`, s1)}
    ${swatchTag(`${group}2`, s2)}
    ${swatchTag(`${group}3`, s3)}
  </div>`;
}

function clubRowHtml(c) {
  const idStr = String(c.clubId);
  const isChecked = selectedClubs.has(idStr);
  const isSelectedRow = (idStr === String(activeClubId));
  const badgeTitle = c.badgePath ? `Badge: ${c.badgePath}` : '';
  const idTitle = badgeTitle ? `ID: ${c.clubId} | ${badgeTitle} (click to copy ID)` : 'Click to copy ID';
  const nameTitle = `${c.club}${c.division ? ' (' + c.division + ')' : ''}${badgeTitle ? '\n' + badgeTitle : ''}`;
  const styleOptions = (kitIndex) => {
    const curStyle = kitStyleOf(c, kitIndex);
    return VALID_STYLES.map(st =>
      `<option value="${st}"${st === curStyle ? ' selected' : ''}>${st}</option>`
    ).join('');
  };

  const isWomen = isWomenClub(c);
  const genderBadge = isWomen 
    ? `<span class="badge-gender badge-women" title="Women's football team">Women</span>`
    : `<span class="badge-gender badge-men" title="Men's football team">Men</span>`;
  const divSub = c.division ? `<div class="td-division-sub" title="${escHtml(c.division)}">${escHtml(c.division)}</div>` : '';

  const sponsorVal = getClubSponsor(c);
  const templateVal = getClubTemplate(c);
  const shortNameVal = getClubShortName(c);
  const badgePathVal = resolveBadgePath(c.club, c.clubId, c.badgePath);
  const badgeFilename = badgePathVal.split(/[/\\]/).pop() || 'badge.png';
  const isFallbackBadge = badgeFilename === 'default_badge.png';

  return `<tr data-club-id="${escHtml(idStr)}" class="${isSelectedRow ? 'row-selected' : ''}">
    <td class="td-check">
      <div class="check-box ${isChecked ? 'checked' : ''}" data-club-id="${escHtml(idStr)}" title="Toggle selection">
        <svg viewBox="0 0 16 16"><polyline points="2.5 8.5 6 12 13.5 4.5"></polyline></svg>
      </div>
    </td>
    <td class="td-name" title="${escHtml(nameTitle)}">
      <div style="display:flex;align-items:center;">
        <span>${escHtml(c.club)}</span>
        ${genderBadge}
      </div>
      ${divSub}
    </td>
    <td class="td-id" title="${escHtml(idTitle)}">${escHtml(c.clubId)}</td>
    <td class="td-sponsor">
      <input type="text" class="table-input td-sponsor-input" data-club-id="${escHtml(idStr)}" value="${escHtml(sponsorVal)}" spellcheck="false" title="Sponsor Grouping (Default: ALL)">
    </td>
    <td class="td-template">
      <input type="text" class="table-input td-template-input" data-club-id="${escHtml(idStr)}" value="${escHtml(templateVal)}" spellcheck="false" title="Template Grouping (Default: ALL)">
    </td>
    <td class="td-shortname">
      <input type="text" class="table-input td-shortname-input" data-club-id="${escHtml(idStr)}" value="${escHtml(shortNameVal)}" spellcheck="false" title="Team Short Name">
    </td>
    <td class="td-badge">
      <span class="badge-location-tag ${isFallbackBadge ? 'badge-location-fallback' : ''}" data-club-id="${escHtml(idStr)}" title="${escHtml(badgePathVal)}">
        🛡️ ${escHtml(badgeFilename)}
      </span>
    </td>
    <td>${swatchesHtml(c, 'home')}</td>
    <td>${swatchesHtml(c, 'away')}</td>
    <td>${swatchesHtml(c, 'third')}</td>
    <td class="td-style"><select class="kit-style-select" data-club-id="${escHtml(idStr)}" data-kit-index="1" title="Select Home kit style">${styleOptions(1)}</select></td>
    <td class="td-style"><select class="kit-style-select" data-club-id="${escHtml(idStr)}" data-kit-index="2" title="Select Away kit style">${styleOptions(2)}</select></td>
    <td class="td-style"><select class="kit-style-select" data-club-id="${escHtml(idStr)}" data-kit-index="3" title="Select Third kit style">${styleOptions(3)}</select></td>
  </tr>`;
}

function render() {
  updateSortIndicators();
  const q = ($('search').value || '').toLowerCase().trim();
  const promptEl = $('search-prompt');
  const tbl = $('tbl');
  const pager = $('pager');
  const btnToggleAll = $('btn-toggle-all-groups');
  const isGenderActive = Boolean(filterGender && filterGender !== 'all');
  const hasActiveFilter = Boolean(q || filterCountry || filterDivision || isGenderActive || showAllClubs);

  if (!hasActiveFilter) {
    if (promptEl) {
      promptEl.classList.remove('hidden');
      const countLabel = $('db-count-label');
      if (countLabel) countLabel.textContent = `${clubs.length.toLocaleString()} clubs available in database.`;
    }
    tbl.classList.add('hidden');
    tbl.style.display = 'none';
    pager.classList.add('hidden');
    if (btnToggleAll) btnToggleAll.classList.add('hidden');
    updateStatus();
    return;
  }

  if (promptEl) promptEl.classList.add('hidden');
  tbl.classList.remove('hidden');
  tbl.style.display = '';

  let list = applyFilter(clubs);
  const tbody = $('tbody');

  if (groupBy === 'none') {
    if (btnToggleAll) btnToggleAll.classList.add('hidden');
    list = sortClubs(list);

    const pageCount = Math.max(1, Math.ceil(list.length / PAGE_SIZE));
    page = Math.min(page, pageCount - 1);
    const pageStart = page * PAGE_SIZE;
    const pageList = list.slice(pageStart, pageStart + PAGE_SIZE);

    tbody.innerHTML = pageList.map(clubRowHtml).join('');

    if (list.length > PAGE_SIZE) {
      pager.classList.remove('hidden');
      $('page-info').textContent = `${pageStart + 1}–${Math.min(pageStart + PAGE_SIZE, list.length)} / ${list.length}`;
      $('btn-prev').disabled = page === 0;
      $('btn-next').disabled = page >= pageCount - 1;
    } else {
      pager.classList.add('hidden');
    }
  } else {
    // Grouped mode (division or country)
    pager.classList.add('hidden');
    if (btnToggleAll) btnToggleAll.classList.remove('hidden');

    const groupMap = new Map();
    for (const c of list) {
      let gKey;
      if (groupBy === 'country') {
        const norm = displayCountry(c.country);
        gKey = norm && norm.trim() ? norm.trim() : '(No Country)';
      } else {
        const raw = c.division;
        gKey = raw && raw.trim() ? raw.trim() : '(No Division)';
      }
      let arr = groupMap.get(gKey);
      if (!arr) {
        arr = [];
        groupMap.set(gKey, arr);
      }
      arr.push(c);
    }

    const sortedGroups = Array.from(groupMap.keys()).sort((a, b) => {
      const aUnk = a.startsWith('(');
      const bUnk = b.startsWith('(');
      if (aUnk && !bUnk) return 1;
      if (!aUnk && bUnk) return -1;
      return a.localeCompare(b, undefined, { numeric: true });
    });

    const allCollapsed = sortedGroups.length > 0 && sortedGroups.every(g => collapsedGroups.has(g));
    if (btnToggleAll) {
      btnToggleAll.textContent = allCollapsed ? 'Expand All' : 'Collapse All';
    }

    let html = '';
    for (const gKey of sortedGroups) {
      const gClubs = sortClubs(groupMap.get(gKey));
      const totalInGroup = gClubs.length;
      const selInGroup = gClubs.filter(c => selectedClubs.has(String(c.clubId))).length;
      const isAllChecked = totalInGroup > 0 && selInGroup === totalInGroup;
      const isIndeterminate = selInGroup > 0 && selInGroup < totalInGroup;
      const isCollapsed = collapsedGroups.has(gKey);

      html += `<tr class="tr-group-header" data-group-name="${escHtml(gKey)}">
        <td colspan="7">
          <div class="group-header-content">
            <span class="group-chevron ${isCollapsed ? 'collapsed' : ''}">▼</span>
            <div class="check-box group-check-box ${isAllChecked ? 'checked' : (isIndeterminate ? 'indeterminate' : '')}" data-group-name="${escHtml(gKey)}" title="Toggle selection for ${escHtml(gKey)}">
              <svg viewBox="0 0 16 16"><polyline points="2.5 8.5 6 12 13.5 4.5"></polyline></svg>
            </div>
            <span class="group-title">${escHtml(gKey)}</span>
            <span class="group-badge">${totalInGroup} ${totalInGroup === 1 ? 'club' : 'clubs'}</span>
          </div>
        </td>
      </tr>`;

      if (!isCollapsed) {
        html += gClubs.map(clubRowHtml).join('');
      }
    }

    tbody.innerHTML = html;
  }
}

function initTableEvents() {
  const tbody = $('tbody');

  tbody.addEventListener('click', e => {
    // 1. Group header interactions
    const groupHeader = e.target.closest('.tr-group-header');
    if (groupHeader) {
      const gKey = groupHeader.dataset.groupName;
      const groupCheck = e.target.closest('.group-check-box');
      if (groupCheck) {
        e.stopPropagation();
        toggleGroupSelection(gKey);
        return;
      }
      toggleGroupCollapse(gKey);
      return;
    }

    // 2. Club checkbox interaction
    const box = e.target.closest('.check-box:not(.group-check-box)');
    if (box) {
      e.stopPropagation();
      const clubId = box.dataset.clubId;
      if (selectedClubs.has(clubId)) {
        selectedClubs.delete(clubId);
      } else {
        selectedClubs.add(clubId);
      }
      updateStatus();
      render();
      return;
    }

    // 3. Swatch interaction
    const sw = e.target.closest('.swatch');
    if (sw) {
      e.stopPropagation();
      const clubId = sw.dataset.clubId;
      const slot = sw.dataset.slot;
      openColorPicker(clubId, slot, sw);
      return;
    }

    // 4. Click ID to copy
    const tdId = e.target.closest('.td-id');
    if (tdId && navigator.clipboard) {
      const idText = tdId.textContent.trim();
      if (idText) {
        navigator.clipboard.writeText(idText).then(() => {
          const statusEl = $('status');
          if (statusEl) {
            statusEl.textContent = `Copied ID ${idText} to clipboard!`;
            setTimeout(() => { updateStatus(); }, 1800);
          }
        }).catch(() => {});
      }
    }

    // 5. Click badge tag to open badge location modal
    const badgeTag = e.target.closest('.badge-location-tag');
    if (badgeTag) {
      e.stopPropagation();
      const badgeModal = $('badge-modal');
      if (badgeModal) {
        badgeModal.classList.remove('hidden');
        const input = $('input-quick-badge-dir');
        if (input) {
          input.value = getLogoDir();
          input.focus();
        }
      }
      return;
    }

    // 6. Row selection
    const tr = e.target.closest('tr[data-club-id]');
    if (tr) {
      const clubId = tr.dataset.clubId;
      activeClubId = clubId;
      tbody.querySelectorAll('tr.row-selected').forEach(r => r.classList.remove('row-selected'));
      tr.classList.add('row-selected');
    }
  });

  tbody.addEventListener('input', e => {
    const target = e.target;
    if (target.classList.contains('td-sponsor-input')) {
      const cid = target.dataset.clubId;
      if (cid) {
        clubSponsors[cid] = target.value.trim() || 'ALL';
        saveTableCustoms();
      }
    } else if (target.classList.contains('td-template-input')) {
      const cid = target.dataset.clubId;
      if (cid) {
        clubTemplates[cid] = target.value.trim() || 'ALL';
        saveTableCustoms();
      }
    } else if (target.classList.contains('td-shortname-input')) {
      const cid = target.dataset.clubId;
      if (cid) {
        clubShortNames[cid] = target.value.trim();
        saveTableCustoms();
      }
    }
  });

  tbody.addEventListener('contextmenu', e => {
    const sw = e.target.closest('.swatch');
    if (sw) {
      e.preventDefault();
      e.stopPropagation();
      const clubId = sw.dataset.clubId;
      const slot = sw.dataset.slot;
      clearColorSlot(clubId, slot, sw);
    }
  });

  tbody.addEventListener('change', e => {
    const sel = e.target.closest('.kit-style-select');
    if (sel) {
      const clubId = sel.dataset.clubId;
      const kitIndex = parseInt(sel.dataset.kitIndex || '1', 10);
      setKitStyle(clubId, sel.value, kitIndex);
    }
  });
}


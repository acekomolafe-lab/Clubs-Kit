  const targetList = selectedClubs.size > 0 ? list.filter(c => selectedClubs.has(String(c.clubId))) : list;

  if (!targetList.length) {
    alert('No clubs to export. Select or filter clubs first.');
    return;
  }

  const jsonArray = buildKitbasherJson(targetList);
  const jsonStr = JSON.stringify(jsonArray, null, 2);
  const blob = new Blob([jsonStr], { type: 'application/json;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = 'teams.json';
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}

function initPathsModal() {
  const modal = $('paths-modal');
  const btnOpen = $('btn-paths-config');
  const btnClose = $('btn-close-paths-modal');
  const btnSave = $('btn-save-paths');
  const btnReset = $('btn-reset-paths');
  const btnBrowseCsv = $('btn-browse-csv-dir');
  const btnBrowseLogo = $('btn-browse-logo-dir');
  const inputCsvName = $('input-csv-name');
  const inputCsv = $('input-csv-dir');
  const inputLogo = $('input-logo-dir');
  const inputSponsorConfig = $('input-sponsor-config');
  const chkPromptSave = $('chk-always-prompt-save');

  if (!modal || !btnOpen) return;

  function openModal() {
    if (inputCsvName) inputCsvName.value = getCsvFilename();
    if (inputCsv) inputCsv.value = getCsvDir();
    if (inputLogo) inputLogo.value = getLogoDir();
    if (inputSponsorConfig) inputSponsorConfig.value = getSponsorConfigPath();
    if (chkPromptSave) chkPromptSave.checked = getPromptSave();
    modal.classList.remove('hidden');
  }

  function closeModal() {
    modal.classList.add('hidden');
  }

  btnOpen.addEventListener('click', openModal);
  if (btnClose) btnClose.addEventListener('click', closeModal);

  // Close when clicking backdrop outside dialog
  modal.addEventListener('click', (e) => {
    if (e.target === modal) {
      closeModal();
    }
  });

  // ESC key to close
  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  if (btnBrowseCsv) {
    btnBrowseCsv.addEventListener('click', async () => {
      try {
        const current = (inputCsv ? inputCsv.value : '') || getCsvDir();
        const selected = await tauriInvoke('select_directory', {
          title: 'Select Kitbasher CSV Save Directory',
          defaultPath: current
        });
        if (selected && inputCsv) {
          inputCsv.value = selected;
        }
      } catch (err) {
        console.warn('tauri select_directory failed:', err);
        const fallback = prompt('Enter folder path for CSV export:', inputCsv ? inputCsv.value : getCsvDir());
        if (fallback !== null && inputCsv) {
          inputCsv.value = fallback.trim();
        }
      }
    });
  }

  if (btnBrowseLogo) {
    btnBrowseLogo.addEventListener('click', async () => {
      try {
        const current = (inputLogo ? inputLogo.value : '') || getLogoDir();
        const selected = await tauriInvoke('select_directory', {
          title: 'Select Club Logos / Badges Directory',
          defaultPath: current
        });
        if (selected && inputLogo) {
          inputLogo.value = selected;
        }
      } catch (err) {
        console.warn('tauri select_directory failed:', err);
        const fallback = prompt('Enter folder path for Club Logos:', inputLogo ? inputLogo.value : getLogoDir());
        if (fallback !== null && inputLogo) {
          inputLogo.value = fallback.trim();
        }
      }
    });
  }

  if (btnReset) {
    btnReset.addEventListener('click', () => {
      if (inputCsvName) inputCsvName.value = DEFAULT_CSV_NAME;
      if (inputCsv) inputCsv.value = DEFAULT_CSV_DIR;
      if (inputLogo) inputLogo.value = DEFAULT_LOGO_DIR;
      if (inputSponsorConfig) inputSponsorConfig.value = DEFAULT_SPONSOR_CONFIG_PATH;
      if (chkPromptSave) chkPromptSave.checked = true;
    });
  }

  if (btnSave) {
    btnSave.addEventListener('click', () => {
      const nameVal = inputCsvName ? inputCsvName.value.trim() : '';
      const csvVal = inputCsv ? inputCsv.value.trim() : '';
      const logoVal = inputLogo ? inputLogo.value.trim() : '';
      const sponsorConfigVal = inputSponsorConfig ? inputSponsorConfig.value.trim() : '';
      const promptVal = chkPromptSave ? chkPromptSave.checked : true;
      setCsvFilename(nameVal);
      setCsvDir(csvVal);
      setLogoDir(logoVal);
      setSponsorConfigPath(sponsorConfigVal);
      setPromptSave(promptVal);
      closeModal();
      const statusEl = $('status');
      if (statusEl) {
        statusEl.textContent = 'Settings saved.';
        statusEl.style.color = '#5aa9ff';
        setTimeout(() => { updateStatus(); }, 4000);
      }
    });
  }

  updateExportButtonTooltip();
}

function initBadgeModal() {
  const modal = $('badge-modal');
  const btnOpen = $('btn-badge-location');
  const btnClose = $('btn-close-badge-modal');
  const btnSave = $('btn-save-quick-badge-dir');
  const btnDefault = $('btn-default-badge-dir');
  const btnBrowse = $('btn-browse-quick-badge-dir');
  const input = $('input-quick-badge-dir');
  const stats = $('badge-folder-stats');

  if (!modal || !btnOpen) return;

  async function checkLiveFolder(path) {
    if (!stats) return;
    const trimmed = (path || '').trim();
    if (!trimmed) {
      stats.textContent = 'Please enter or select a folder path.';
      stats.style.color = '#888';
      return;
    }
    try {
      const res = await tauriInvoke('check_badge_directory', { dir: trimmed });
      if (res && res.exists) {
        if (res.count > 0) {
          const sampleStr = (res.sample && res.sample.length) ? ` (e.g. ${res.sample.slice(0, 2).join(', ')})` : '';
          const subfolderNote = (res.subfolders && res.subfolders > 0) ? ` across ${res.subfolders.toLocaleString()} subfolders` : '';
          stats.textContent = `✓ Folder valid: ${res.count.toLocaleString()} badge files found (searched recursively${subfolderNote})${sampleStr}`;
          stats.style.color = '#52c41a';
        } else {
          stats.textContent = '⚠️ Folder exists, but 0 badge images (.png, .svg, .jpg) were found in it or its subfolders.';
          stats.style.color = '#faad14';
        }
      } else {
        stats.textContent = '❌ Folder does not exist on disk.';
        stats.style.color = '#ff4d4f';
      }
    } catch (e) {
      stats.textContent = '';
    }
  }

  let checkTimer = null;
  function triggerCheck() {
    clearTimeout(checkTimer);
    checkTimer = setTimeout(() => {
      if (input) checkLiveFolder(input.value);
    }, 250);
  }

  function openModal() {
    if (input) {
      input.value = getLogoDir();
      triggerCheck();
      modal.classList.remove('hidden');
      setTimeout(() => {
        input.focus();
        input.select();
      }, 50);
    } else {
      modal.classList.remove('hidden');
    }
  }

  function closeModal() {
    modal.classList.add('hidden');
  }

  btnOpen.addEventListener('click', openModal);
  if (btnClose) btnClose.addEventListener('click', closeModal);

  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });

  function saveAndClose() {
    const val = input ? input.value.trim() : '';
    setLogoDir(val);
    closeModal();
    const statusEl = $('status');
    if (statusEl) {
      statusEl.textContent = `Badge folder set to: ${getLogoDir()}`;
      statusEl.style.color = '#5aa9ff';
      setTimeout(() => { updateStatus(); }, 4000);
    }
  }

  if (input) {
    input.addEventListener('input', triggerCheck);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        e.preventDefault();
        saveAndClose();
      }
    });
  }

  if (btnBrowse) {
    btnBrowse.addEventListener('click', async () => {
      try {
        const current = (input ? input.value : '') || getLogoDir();
        const selected = await tauriInvoke('select_directory', {
          title: 'Select Club Badges / Logos Folder',
          defaultPath: current
        });
        if (selected && input) {
          input.value = selected;
          checkLiveFolder(selected);
        }
      } catch (err) {
        console.warn('tauri select_directory failed:', err);
        const fallback = prompt('Enter folder path for Club Badges:', input ? input.value : getLogoDir());
        if (fallback !== null && input) {
          input.value = fallback.trim();
          checkLiveFolder(input.value);
        }
      }
    });
  }

  if (btnDefault) {
    btnDefault.addEventListener('click', () => {
      if (input) {
        input.value = DEFAULT_LOGO_DIR;
        checkLiveFolder(DEFAULT_LOGO_DIR);
      }
    });
  }

  if (btnSave) {
    btnSave.addEventListener('click', saveAndClose);
  }

  updateBadgeButtonTooltip();
}


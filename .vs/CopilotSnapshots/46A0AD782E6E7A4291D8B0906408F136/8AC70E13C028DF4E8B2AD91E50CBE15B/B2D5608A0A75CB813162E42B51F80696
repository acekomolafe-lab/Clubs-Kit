    if (groupBy === 'country') {
      const norm = displayCountry(c.country);
      key = norm && norm.trim() ? norm.trim() : '(No Country)';
    } else {
      const raw = c.division;
      key = raw && raw.trim() ? raw.trim() : '(No Division)';
    }

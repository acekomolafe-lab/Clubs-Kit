function normalizeSponsorKey(value) {
  return String(value || '')
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '');
}

function sponsorGroupingByKeys(groupings, keys) {
  const byKey = new Map();
  for (const group of groupings) {
    if (!group || typeof group.name !== 'string') continue;
    const key = normalizeSponsorKey(group.name);
    if (key && !byKey.has(key)) byKey.set(key, group);
  }

  for (const key of keys) {
    const group = byKey.get(normalizeSponsorKey(key));
    if (group) return group;
  }
  return null;
}

function sponsorGroupingForCountry(country, groupings) {

  const candidates = [];
  const addCandidate = value => {
    const key = normalizeSponsorKey(value);
    if (key && !candidates.includes(key)) candidates.push(key);
  };

  const rawCountry = String(country || '').trim();
  addCandidate(rawCountry);
  addCandidate(displayCountry(rawCountry));
  for (const [source, target] of Object.entries(COUNTRY_MAP)) {
    if (normalizeSponsorKey(source) === normalizeSponsorKey(rawCountry)) {
      addCandidate(target);
    }
  }

  for (const candidate of [...candidates]) {
    for (const alias of SPONSOR_GROUP_ALIASES[candidate] || []) addCandidate(alias);
  }

  return sponsorGroupingByKeys(groupings, candidates);
}

const RED_BULL_TEAM_REGEX = /\bred\s*bull\b|\brb\s+(?:leipzig|salzburg|bragantino)\b|\b(?:rbl|rbs)\b/i;

function sponsorGroupingForClub(club, groupings) {
  const clubId = String(club.clubId || club.id || '');
  const names = [club.club, club.name, club.shortName, club.initials, clubShortNames[clubId]];
  if (names.some(value => RED_BULL_TEAM_REGEX.test(String(value || '')))) {
    const redBullGroup = sponsorGroupingByKeys(groupings, ['Red Bull My']);
    if (redBullGroup) return redBullGroup;
  }
  return sponsorGroupingForCountry(club.country, groupings);
}

async function autoAssignSponsorsByCountry() {
  const button = $('btn-auto-sponsors');
  if (!clubs.length) {
    alert('No clubs are loaded. Load the club database first.');
    return;
  }

  if (button) button.disabled = true;
  const statusEl = $('status');
  if (statusEl) statusEl.textContent = 'Reading sponsor groupings…';

  try {
    const groupings = await tauriInvoke('get_sponsor_groupings', {
      configPath: getSponsorConfigPath()
    });
    if (!Array.isArray(groupings) || !groupings.length) {
      throw new Error('The sponsor config contains no sponsor groupings.');
    }

    let assigned = 0;
    let skipped = 0;
    let genericAssigned = 0;
    const genericCountries = new Set();

    for (const club of clubs) {
      const clubId = String(club.clubId || club.id || '');
      const current = getClubSponsor(club);
      if (current && current !== 'ALL') {
        skipped++;
        continue;
      }

      const grouping = sponsorGroupingForClub(club, groupings);
      if (!grouping) {
        clubSponsors[clubId] = 'ALL';
        genericAssigned++;
        genericCountries.add(displayCountry(club.country) || '(No Country)');
      } else {
        clubSponsors[clubId] = grouping.name;
      }
      assigned++;
    }

    saveTableCustoms();
    render();
    const countryList = Array.from(genericCountries).sort((a, b) => a.localeCompare(b)).slice(0, 8);
    const message = `Assigned ${assigned.toLocaleString()} sponsors; skipped ${skipped.toLocaleString()} existing assignments; used generic ALL for ${genericAssigned.toLocaleString()} teams.`;
    if (statusEl) {
      statusEl.textContent = message;
      statusEl.style.color = '#f5d978';
      setTimeout(() => { updateStatus(); }, 7000);
    }
    alert(countryList.length ? `${message}\nUnmatched countries: ${countryList.join(', ')}` : message);
  } catch (err) {
    const message = `Could not assign sponsors: ${String(err.message || err)}`;
    if (statusEl) {
      statusEl.textContent = message;
      statusEl.style.color = '#ff8f8f';
    }
    alert(message);
  } finally {
    if (button) button.disabled = false;
  }
}


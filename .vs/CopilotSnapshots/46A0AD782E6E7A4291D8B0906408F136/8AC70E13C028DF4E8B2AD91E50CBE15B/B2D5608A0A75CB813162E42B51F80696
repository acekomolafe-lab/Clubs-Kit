function formatHexColor(val) {
  if (!val) return '';
  let s = String(val).trim();
  if (/^#?[0-9a-fA-F]{6}$/.test(s)) {
    return s.startsWith('#') ? s.toUpperCase() : '#' + s.toUpperCase();
  }
  return s;
}

async function exportCsv(forceSaveAs = false) {
  const q = ($('search').value || '').trim();
  const hasActiveFilter = Boolean(q || filterCountry || filterDivision || (filterGender && filterGender !== 'all') || showAllClubs);
  const filtered = hasActiveFilter ? applyFilter(clubs) : clubs;
  const list = sortClubs(filtered);
  const targetList = selectedClubs.size > 0 ? list.filter(c => selectedClubs.has(String(c.clubId))) : list;

  if (!targetList.length) {
    alert('No clubs to export. Select or filter clubs first.');
    return;
  }

  const defaultDir = getCsvDir();
  const defaultFilename = getCsvFilename();
  const shouldPrompt = forceSaveAs || getPromptSave();

  let targetFullPath = null;
  let targetFilename = defaultFilename;
  let targetDir = defaultDir;

  if (shouldPrompt) {
    try {
      const chosen = await tauriInvoke('select_save_file', {
        title: 'Save Teams CSV',
        defaultDir: defaultDir,
        defaultFilename: defaultFilename,
        filterName: 'CSV Files',
        filterExt: 'csv'
      });
      if (!chosen) return; // User cancelled
      targetFullPath = chosen;
      const parts = chosen.split(/[/\\]/);
      targetFilename = parts[parts.length - 1] || defaultFilename;
      targetDir = parts.slice(0, -1).join('\\') || defaultDir;
    } catch (e) {
      console.warn('select_save_file failed or not in Tauri, falling back:', e);
    }
  }

  const shouldSuffixWomen = $('chk-suffix-women') ? $('chk-suffix-women').checked : true;
  const badgeDir = getLogoDir();

  // Resolve badges on disk using backend if available so Kitbasher never fails File.Exists
  let badgeMap = {};
  try {
    const queryList = targetList.map(c => ({
      id: String(c.clubId || ''),
      name: c.club || '',
      existing_path: c.badgePath || null
    }));
    badgeMap = await tauriInvoke('resolve_badges', {
      badgeDir: badgeDir,
      clubs: queryList
    }) || {};
  } catch (err) {
    console.warn('resolve_badges invoke failed, using client fallback:', err);
  }

  // 23-column format matching the image specification
  const rows = [];

  for (const c of targetList) {
    const isW = isWomenClub(c);
    let clubName = c.club || '';
    if (isW && shouldSuffixWomen) {
      if (!/women|ladies|feminin|frauen|\(w\)/i.test(clubName)) {
        clubName = `${clubName} Women`;
      }
    }
    const clubId = String(c.clubId || '');
    const sponsorGrouping = getClubSponsor(c);
    const templateGrouping = getClubTemplate(c);
    const shortName = getClubShortName(c);
    const badgePath = badgeMap[clubId] || resolveBadgePath(c.club, clubId, c.badgePath);

    const home1 = formatHexColor(kitColorOf(c.clubId, 'home1') || c.k1BgColor || c.bgColor || '');
    const home2 = formatHexColor(kitColorOf(c.clubId, 'home2') || c.k1FgColor || c.fgColor || home1);
    const home3 = formatHexColor(kitColorOf(c.clubId, 'home3') || c.k1OutColor || c.outlineColor || home2 || home1);

    const away1 = formatHexColor(kitColorOf(c.clubId, 'away1') || c.k2BgColor || home2 || '');
    const away2 = formatHexColor(kitColorOf(c.clubId, 'away2') || c.k2FgColor || home1 || away1);
    const away3 = formatHexColor(kitColorOf(c.clubId, 'away3') || c.k2OutColor || away2 || away1);

    const third1 = formatHexColor(kitColorOf(c.clubId, 'third1') || c.k3BgColor || '');
    const third2 = formatHexColor(kitColorOf(c.clubId, 'third2') || c.k3FgColor || third1);
    const third3 = formatHexColor(kitColorOf(c.clubId, 'third3') || c.k3OutColor || third2 || third1);

    const kitDesign1 = kitStyleOf(c, 1);
    const kitDesign2 = kitStyleOf(c, 2);
    const kitDesign3 = kitStyleOf(c, 3);

    rows.push([
      clubName,
      clubId,
      '',
      sponsorGrouping,
      templateGrouping,
      shortName,
      badgePath,
      home1,
      home2,
      home3,
      away1,
      away2,
      away3,
      third1,
      third2,
      third3,
      kitDesign1,
      kitDesign2,
      kitDesign3,
      shortName
    ]);
  }

  const csv = rows.map(r => r.map(escCsv).join(',')).join('\r\n');

  try {
    const savedPath = await tauriInvoke('save_teams_csv', {
      csvContent: '\uFEFF' + csv,
      filename: targetFilename,
      directory: targetDir,
      fullPath: targetFullPath
    });
    const msg = `Saved ${targetList.length} clubs to ${savedPath}`;
    const statusEl = $('status');
    if (statusEl) {
      statusEl.textContent = msg;
      statusEl.style.color = '#5aa9ff';
      setTimeout(() => { updateStatus(); }, 6000);
    }
    alert(msg);
    return;
  } catch (err) {
    console.warn('tauriInvoke save_teams_csv failed, falling back to browser download:', err);
  }

  // Fallback for browser
  const blob = new Blob(['\uFEFF' + csv], { type: 'text/csv;charset=utf-8;' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = targetFilename;
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
}


const NAMED_COLORS = {
  '#ffffff': 'White', '#000000': 'Black', '#ff0000': 'Red', '#0000ff': 'Blue',
  '#008000': 'Green', '#ffff00': 'Yellow', '#ffd700': 'Gold', '#ffa500': 'Orange',
  '#ff8c00': 'DarkOrange', '#808080': 'Gray', '#c0c0c0': 'Silver', '#2e8b57': 'SeaGreen',
  '#00ffff': 'Cyan', '#000080': 'Navy', '#87ceeb': 'SkyBlue', '#4169e1': 'RoyalBlue',
  '#800000': 'Maroon', '#800080': 'Purple', '#ee82ee': 'Violet', '#f5f5dc': 'Beige',
  '#a52a2a': 'Brown', '#00ff00': 'Lime', '#4682b4': 'SteelBlue', '#1e90ff': 'DodgerBlue',
  '#00ced1': 'DarkTurquoise', '#98fb98': 'PaleGreen', '#20b2aa': 'LightSeaGreen',
  '#ff1493': 'DeepPink', '#ff69b4': 'HotPink', '#da70d6': 'Orchid', '#dda0dd': 'Plum',
  '#b22222': 'Firebrick', '#8b0000': 'DarkRed', '#d2691e': 'Chocolate', '#f4a460': 'SandyBrown'
};

function formatKitColor(val) {
  if (!val) return '';
  const v = String(val).trim();
  if (/^[A-Za-z]+$/.test(v) || /^\d+\s*,\s*\d+\s*,\s*\d+$/.test(v)) return v;
  if (v.startsWith('#')) {
    const hex = v.toLowerCase();
    if (NAMED_COLORS[hex]) return NAMED_COLORS[hex];
    if (hex.length === 7) {
      const r = parseInt(hex.slice(1, 3), 16);
      const g = parseInt(hex.slice(3, 5), 16);
      const b = parseInt(hex.slice(5, 7), 16);
      return `${r}, ${g}, ${b}`;
    }
    if (hex.length === 4) {
      const r = parseInt(hex[1] + hex[1], 16);
      const g = parseInt(hex[2] + hex[2], 16);
      const b = parseInt(hex[3] + hex[3], 16);
      return `${r}, ${g}, ${b}`;
    }
  }
  return v;
}

function resolveBadgePath(clubName, clubId, clubBadgePath) {
  const logoDir = getLogoDir();
  let filename = '';
  if (clubBadgePath && typeof clubBadgePath === 'string' && clubBadgePath.trim()) {
    const trimmed = clubBadgePath.trim();
    const parts = trimmed.split(/[/\\]/);
    filename = parts[parts.length - 1];
  }
  if (!filename) {
    const clean = String(clubName || '').replace(/[\/\\:\*\?"<>\|]/g, '').trim();
    const fileClean = clean.replace(/\s+/g, '_');
    filename = `${fileClean} Logo.png`;
  }
  if (logoDir) {
    const cleanDir = logoDir.replace(/[/\\]+$/, '');
    return `${cleanDir}\\${filename}`;
  }
  return filename;
}

function generateInitials(name) {
  if (!name) return 'FC';
  const words = name.replace(/[^a-zA-Z\s]/g, ' ')
                    .split(/\s+/)
                    .filter(w => w.length > 0 && !['of', 'and', 'the', '&'].includes(w.toLowerCase()));
  if (!words.length) return 'FC';
  return words.map(w => w[0].toUpperCase()).join('').slice(0, 5);
}

function generateShortName(c) {
  if (c.nickname && c.nickname.trim()) return c.nickname.trim();
  if (c.shortName && c.shortName.trim()) return c.shortName.trim();
  const stripped = (c.club || '').replace(/\s*(?:F\.?C\.?|A\.?F\.?C\.?)\s*/gi, ' ').trim();
  return stripped || c.club || '';
}

function buildKitbasherJson(clubsList) {
  return clubsList.map(c => {
    const clubName = c.club || '';
    const clubIdStr = String(c.clubId || '');
    const badgePath = resolveBadgePath(clubName, clubIdStr, c.badgePath);
    const shortName = c.shortName || generateShortName(c);
    const initials = c.initials || generateInitials(clubName);

    const kits = [];

    function addKit(kitType, slotPrefix, isKit0) {
      const col1 = kitColorOf(clubIdStr, `${slotPrefix}1`);
      const col2 = kitColorOf(clubIdStr, `${slotPrefix}2`) || col1;
      const col3 = kitColorOf(clubIdStr, `${slotPrefix}3`) || col2 || col1;
      const c1 = formatKitColor(col1) || (kitType === 0 ? 'Red' : (kitType === 1 ? 'White' : 'Yellow'));
      const c2 = formatKitColor(col2) || (kitType === 0 ? 'White' : 'Black');
      const c3 = formatKitColor(col3) || (kitType === 0 ? 'Black' : 'Gold');

      kits.push({
        KitType: kitType,
        TeamName: clubName,
        TeamId: clubIdStr,
        KitColors: [c1, c2, c3],
        KitTemplateDetails: {
          Location: null,
          Placements: null,
          MatchEngineSettings: {
            Location: null,
            EnginePlacements: null,
            TextInserts: null
          },
          Name: null,
          TextInserts: null,
          DesignType: 0
        },
        MainColor: c1,
        BadgePath: badgePath,
        ContrastBadge: null,
        LayoutItems: null,
        LayoutId: null,
        IsStriped: null,
        KitDesignType: isKit0 ? 0 : null,
        ShortName: shortName,
        Initials: initials,
        ShortsBase: -1,
        SocksBase: -1,
        SponsorBase: -1,
        ContrastBadgeColourBase: -1
      });
    }

    // Kit 0: Home (always present)
    addKit(0, 'home', true);

    // Kit 1: Away
    addKit(1, 'away', false);

    // Kit 2: Third (if third colors configured)
    const third1 = kitColorOf(clubIdStr, 'third1');
    const third2 = kitColorOf(clubIdStr, 'third2');
    const third3 = kitColorOf(clubIdStr, 'third3');
    if (third1 || third2 || third3) {
      addKit(2, 'third', false);
    }

    return {
      Name: clubName,
      TeamId: clubIdStr,
      SponsorGrouping: getClubSponsor(c),
      TemplateGrouping: "",
      LayoutId: null,
      SavedHistory: null,
      Selected: true,
      Kits: kits,
      ShortName: shortName,
      Initials: initials
    };
  });
}


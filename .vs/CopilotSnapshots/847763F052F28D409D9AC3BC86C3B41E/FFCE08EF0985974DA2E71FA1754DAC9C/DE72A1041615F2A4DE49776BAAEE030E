[package]
name = "FMSuperScout"
version = "0.1.0"
description = "A Tauri App"
authors = ["you"]
license = ""
repository = ""
edition = "2021"
rust-version = "1.77.2"

[[bin]]
name = "FMSuperScout"
path = "src/main.rs"



[build-dependencies]
tauri-build = { version = "2.6.3" }

[dependencies]
serde_json = "1.0"
serde = { version = "1.0", features = ["derive"] }
log = "0.4"
tauri = { version = "2.11.3", features = ["protocol-asset"] }
tauri-plugin-log = "2"
winreg = "0.56.0"
sysinfo = "0.36.1"
reqwest = { version = "0.13.3", features = ["blocking", "json"] }
tauri-plugin-fs = "2.5.2"
tauri-plugin-shell = "2.3.6"
lazy_static = "1.5.0"
sha2 = "0.10.9"
dirs = "7.0.0"
rfd = "0.15"
